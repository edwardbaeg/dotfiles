# Ghostty Configuration

# Font
font-family = 0xProto
font-size = 16
adjust-cell-height = 10%

# Window
window-padding-x = 16
window-padding-y = 16
macos-titlebar-style = hidden

# Bell
bell-features = system,attention,title

# Cursor trail (closest match to kitty's cursor_trail)
custom-shader = shaders/cursor_warp.glsl

# Keybinds
keybind = super+shift+ctrl+comma=reload_config

# Send same escape sequence as opt+n for cmd+n for tmux M-n bindings
# Both forms are overridden since Ghostty's defaults bind each to goto_tab
keybind = super+1=text:\x1b1
keybind = super+digit_1=text:\x1b1
keybind = super+2=text:\x1b2
keybind = super+digit_2=text:\x1b2
keybind = super+3=text:\x1b3
keybind = super+digit_3=text:\x1b3
keybind = super+4=text:\x1b4
keybind = super+digit_4=text:\x1b4
keybind = super+5=text:\x1b5
keybind = super+digit_5=text:\x1b5
keybind = super+6=text:\x1b6
keybind = super+digit_6=text:\x1b6
keybind = super+7=text:\x1b7
keybind = super+digit_7=text:\x1b7
keybind = super+8=text:\x1b8
keybind = super+digit_8=text:\x1b8
keybind = super+9=text:\x1b9
keybind = super+digit_9=text:\x1b9

# Same idea for tmux's other prefixless M- bindings; overrides Ghostty's
# defaults for these keys (split, search, undo, font size) in favor of tmux
keybind = super+s=text:\x1bs
keybind = super+d=text:\x1bd
keybind = super+f=text:\x1bf
keybind = super+z=text:\x1bz
keybind = super+slash=text:\x1b/
keybind = super+backslash=text:\x1b\\
keybind = super+-=text:\x1b-
